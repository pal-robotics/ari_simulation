<?xml version="1.0"?>
<package format="3">
  <name>ari_gazebo</name>
  <version>2.1.0</version>
  <description>The ari_gazebo package</description>
  <author email="severin.lemaignan@pal-robotics.com">Séverin Lemaignan</author>
  <author email="andrea.capodacqua@pal-robotics.com">Andrea Capodacqua</author>
  <maintainer email="severin.lemaignan@pal-robotics.com">Séverin Lemaignan</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch_pal</exec_depend>
  <exec_depend>pal_gazebo_worlds</exec_depend>
  <exec_depend>pal_maps</exec_depend>
  <exec_depend>pal_gazebo_plugins</exec_depend>
  <exec_depend>play_motion2_msgs</exec_depend>
  <exec_depend>ari_bringup</exec_depend>
  <exec_depend>ari_description</exec_depend>
  <exec_depend>ari_2dnav</exec_depend>
  <exec_depend>ari_laser_sensors</exec_depend>
  <exec_depend>pal_urdf_utils</exec_depend>
  <exec_depend>ari_moveit_config</exec_depend>
  <exec_depend condition="$PAL_DISTRO >= alum">robot_info_publisher</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
